programa {
  funcao inicio() {
    inteiro numero[5] 
    inteiro x, y, z
    escreva("Digite o valor do primeiro indíce: ")
    leia(x)
    escreva("Digite o valor do segundo indíce: ")
    leia(y)
    escreva("Digite o valor do terceiro indíce: ")
    leia(z)

    numero[0] = x
    numero[1] = y
    numero[2] = z
    numero[3] = 10 
    numero[4] = 20

    escreva(numero[0], "\n")
    escreva(numero[1], "\n")
    escreva(numero[2], "\n")
    escreva(numero[3], "\n")
    escreva(numero[4], "\n")
  }
}
